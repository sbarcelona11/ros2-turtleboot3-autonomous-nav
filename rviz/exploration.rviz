Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Coverage map
      Enabled: true
      Alpha: 0.8
      Topic:
        Value: /coverage_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Update Topic:
        Value: /coverage_map_updates
    - Class: rviz_default_plugins/LaserScan
      Name: Laser scan
      Enabled: true
      Size (m): 0.03
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 1
      Topic:
        Value: /odom_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: cmd_vel and coverage metrics
      Enabled: true
      Topic:
        Value: /exploration_status
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      # RViz's top-down view points +X up the screen by default, which reads as
      # the scenario turned a quarter turn against the Gazebo camera. This puts
      # +X to the right and +Y up, the orientation a floor plan is read in.
      Angle: -1.5708
      Scale: 75
      Target Frame: odom
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 850
